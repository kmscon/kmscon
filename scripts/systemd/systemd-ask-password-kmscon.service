[Unit]
Description=Dispatch Password Requests to kmscon
DefaultDependencies=no
Conflicts=shutdown.target getty@tty1.service kmsconvt@tty1.service
After=systemd-udevd.service systemd-vconsole-setup.service
Before=shutdown.target getty@tty1.service display-manager.service

[Service]
Type=oneshot
ExecStart=kmscon --oneshot --no-issue --vt=tty1 --login -- systemd-tty-ask-password-agent --query
StandardInput=null
StandardOutput=journal
StandardError=journal
